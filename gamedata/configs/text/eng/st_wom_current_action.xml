  <!-- Current-action templates for the closing line of the "What have you been up to?" recap.  -->
  <!-- Chosen by render_current_action() in wom_recap_npc.script via a goal+role cascade.      -->
  <!-- These follow a now-lead transition (e.g. "And now?") already picked from                -->
  <!-- st_wom_ask_recap_now_lead_* in st_wom_recap_day.xml.                                    -->
  <!--                                                                                          -->
  <!-- Slots:                                                                                   -->
  <!--   #Im_Were_u#  "I'm" / "We're"                                                          -->
  <!--   #I_We_u#     "I" / "We"                                                               -->
  <!--   #I_we_l#     "i" / "we"                                                               -->
  <!--   #Ive_Weve_u# "I've" / "We've"                                                         -->
  <!--   #my_our_l#   "my" / "our"                                                             -->
  <!--   #me_us_l#    "me" / "us"                                                              -->
  <!--   #location#   smart terrain display name; falls back to "a location" when unknown      -->
  <!--   #intent#     short goal fragment for role frames, "" when no template (gated)         -->
  <!--   #some_members_other# faction that triggered this goal, e.g. "some Bandits"; "someone" when   -->
  <!--                the AP record has no second party                                        -->
  <!--                                                                                          -->
  <!-- Only consequences an ALifePlus handler can assign to a HUMAN squad appear here. The      -->
  <!-- speaker of a current-action line is always a human stalker (wom_bark.is_human_faction),  -->
  <!-- so mutant-gated consequences — area_infest, area_swarm, massacre_scavenge,               -->
  <!-- harvest_haunt, wounded_hunt, alphakill_targeted, alpha_promote, and the instinct set     -->
  <!-- (feed / slumber_* / roam / pack / scatter) — are unreachable and deliberately absent.    -->
  <!-- Check the acting squad's alignment gate in ALifePlus before adding a new pool.           -->


