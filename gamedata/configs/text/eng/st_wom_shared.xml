<?xml version="1.0" encoding="utf-8"?>
<string_table>
  <!-- ===== timestamp prefixes (prepended to an event line; news is lower-cased -->
  <!-- after the comma). Tokens: #Period# "This morning", #period# "this morning", -->
  <!-- #clock# "3:45" (12h, rounded to 15 min), #Ago# "About 10 hours ago". an_stamp is used when -->
  <!-- a clock is known; an_stamp_noclock is the fallback when it isn't. ===== -->
  <string id="st_wom_event_stamp_001"><text>#Period#,</text></string>
  <string id="st_wom_event_stamp_002"><text>#Period# around #clock#,</text></string>
  <string id="st_wom_event_stamp_003"><text>Around #clock# #period#,</text></string>

  <!-- Timeless stamp variants — used instead of the TOD stamps for mutant events   -->
  <!-- (infest, swarm, alpha, alphakill), where an exact or approximate time is not  -->
  <!-- meaningful. No trailing comma: emit_fn in render_report appends ", " itself,  -->
  <!-- the same way it does after make_time_stamp (which also strips its own comma). -->
  <string id="st_wom_event_stamp_timeless_001"><text>At some point</text></string>

  <!-- TIME-OF-DAY leads. The recap groups events by period; the FIRST event of a -->
  <!-- period leads with one of these (filling keeping #I_we_blank_l# = I/we), e.g. -->
  <!-- "This morning, I cracked open a stash." Add as many variants as you like. -->
  <string id="st_wom_ask_recap_tod_early_001"><text>Before dawn</text></string>
  <string id="st_wom_ask_recap_tod_morning_001"><text>This morning</text></string>
  <string id="st_wom_ask_recap_tod_morning_002"><text>After dawn</text></string>
  <string id="st_wom_ask_recap_tod_morning_003"><text>Late morning</text></string>
  <string id="st_wom_ask_recap_tod_afternoon_001"><text>This afternoon</text></string>
  <string id="st_wom_ask_recap_tod_afternoon_002"><text>In the afternoon</text></string>
  <string id="st_wom_ask_recap_tod_evening_001"><text>This evening</text></string>
  <string id="st_wom_ask_recap_tod_nightfall_001"><text>After nightfall</text></string>
  <string id="st_wom_ask_recap_tod_nightfall_002"><text>After dark</text></string>

  <!-- YESTERDAY time-of-day leads — same periods, previous calendar day -->
  <string id="st_wom_ask_recap_tod_yesterday_early_001"><text>Yesterday before dawn</text></string>
  <string id="st_wom_ask_recap_tod_yesterday_morning_001"><text>Yesterday morning</text></string>
  <string id="st_wom_ask_recap_tod_yesterday_afternoon_001"><text>Yesterday afternoon</text></string>
  <string id="st_wom_ask_recap_tod_yesterday_evening_001"><text>Yesterday evening</text></string>
  <string id="st_wom_ask_recap_tod_yesterday_nightfall_001"><text>Last night</text></string>

  <!-- SEQUENCE connectors. All events after the global first use one of these. -->
  <!-- Variants referencing #clock# or #Ago# are gated and only picked when those -->
  <!-- values are available. Plain variants serve as fallbacks. -->
  <string id="st_wom_ask_recap_seq_mid_001"><text>After that</text></string>
  <string id="st_wom_ask_recap_seq_mid_002"><text>Then</text></string>
  <string id="st_wom_ask_recap_seq_mid_003"><text>A bit later</text></string>
  <string id="st_wom_ask_recap_seq_mid_004"><text>Afterwards</text></string>
  <string id="st_wom_ask_recap_seq_mid_005"><text>From there</text></string>
  <string id="st_wom_ask_recap_seq_mid_006"><text>Next</text></string>

  <string id="st_wom_ask_recap_seq_mid_007"><text>Then around #clock#</text></string>
  <string id="st_wom_ask_recap_seq_mid_008"><text>Then at about #clock#</text></string>
  <string id="st_wom_ask_recap_seq_mid_009"><text>#Ago#</text></string>

  <!-- SAME-TIME connectors. Used instead of a sequence connector when the previous -->
  <!-- and current events started within a few in-game minutes of each other -->
  <!-- (typically two ALifePlus consequences reacting to the same cause). -->
  <string id="st_wom_ask_recap_seq_same_time_001"><text>At the same time</text></string>
  <string id="st_wom_ask_recap_seq_same_time_002"><text>Meanwhile</text></string>
  <string id="st_wom_ask_recap_seq_same_time_003"><text>Right about then</text></string>

  <!-- ========================================================================= -->
  <!-- SQUAD STATUS (first line — wom_recap_npc.render_squad_status)              -->
  <!-- SHARED: rendered both by the "What have you been up to?" daily recap and   -->
  <!-- by the faction wire reply (wom_chatter_pda), which renders the same        -->
  <!-- function for an offline squad. Only the leader/alone pools are reachable   -->
  <!-- offline; the follower/member pools are online-only. Edit with both in mind.-->
  <!-- No trailing period; Lua adds "." or ", <absent clause>."                   -->
  <!-- ========================================================================= -->

  <!-- Alone (npc_count <= 1) -->
  <string id="st_wom_recap_status_alone_001"><text>I'm on my own at the moment</text></string>
  <string id="st_wom_recap_status_alone_002"><text>Flying solo right now</text></string>
  <string id="st_wom_recap_status_alone_003"><text>Just me out here today</text></string>

  <!-- Leader, 2-member squad: #partner_name# = other member's first name -->
  <string id="st_wom_recap_status_leader_pair_001"><text>Currently running with my companion #partner_name#</text></string>
  <string id="st_wom_recap_status_leader_pair_002"><text>Running with my partner #partner_name# right now</text></string>
  <string id="st_wom_recap_status_leader_pair_003"><text>On point with my comrade #partner_name#</text></string>
  <string id="st_wom_recap_status_leader_pair_004"><text>Currently working with my partner #partner_name#</text></string>
  <string id="st_wom_recap_status_leader_pair_005"><text>Working with my comrade #partner_name#</text></string>

  <!-- Leader, 3+ squad: #squad_term# = faction collective noun, #squad_count# = number word -->
  <string id="st_wom_recap_status_leader_squad_001"><text>Currently leading a #squad_term# of #squad_count#</text></string>
  <string id="st_wom_recap_status_leader_squad_002"><text>Running a #squad_term# of #squad_count# right now</text></string>

  <!-- Follower, 2-member squad: #leader_name# = commander's first name -->
  <string id="st_wom_recap_status_follower_pair_001"><text>Currently paired up, #leader_name# is taking point</text></string>
  <string id="st_wom_recap_status_follower_pair_002"><text>Working under #leader_name# right now, just the two of us</text></string>

  <!-- Follower, 3+ squad: #leader_name#, #squad_term#, #squad_count# -->
  <string id="st_wom_recap_status_follower_squad_001"><text>Following #leader_name#, #squad_count# in our #squad_term#</text></string>
  <string id="st_wom_recap_status_follower_squad_002"><text>Running with #leader_name#'s #squad_term#, #squad_count# of us in total</text></string>

  <!-- Follower, 2-member, no commander resolved: no leader name available -->
  <string id="st_wom_recap_status_member_pair_001"><text>Running with one other right now</text></string>
  <string id="st_wom_recap_status_member_pair_002"><text>Just two of us out here</text></string>

  <!-- Follower, 3+ squad, no commander resolved: #squad_term#, #squad_count# -->
  <string id="st_wom_recap_status_member_squad_001"><text>Part of a #squad_term# of #squad_count# right now</text></string>
  <string id="st_wom_recap_status_member_squad_002"><text>Running with a #squad_term# of #squad_count#</text></string>

  <!-- Absent-member appended clause (Lua lowercases first letter via decapitalize_clause) -->
  <!-- Online-only: an offline squad is a single alife point, so nobody can be absent. -->
  <!-- Singular: #absent_name# -->
  <string id="st_wom_recap_status_absent_one_001"><text>although I don't know what #absent_name# is up to</text></string>
  <string id="st_wom_recap_status_absent_one_002"><text>although I'm not sure where #absent_name# is at the moment</text></string>
  <!-- Plural: #absent_names# = joined list of first names -->
  <string id="st_wom_recap_status_absent_many_001"><text>although I don't know what #absent_names# are up to</text></string>
  <string id="st_wom_recap_status_absent_many_002"><text>although I'm not sure where #absent_names# are at</text></string>

</string_table>