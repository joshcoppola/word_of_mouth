<?xml version="1.0" encoding="windows-1251"?>
<string_table>
    <!-- Faction-wire question templates for wom_chatter_pda.script.
         Russian mirror of st_wom_chatter_pda.xml (eng). Comments stay in English.

         Key format: st_wom_chatter_pda_ask_{NNN}
         One is picked at random. Variants referencing a slot whose value is empty are
         filtered out by pick_dialogue_variant's gated_tokens before selection, so the
         pool must keep enough location-free lines to survive an unresolvable location.

         Note get_location_name returns the engine name unchanged for non-English
         locales, so #location# here carries no region suffix and no article folding.

         Available slots:
           #location#  — where the asker is holed up (always off the player's map).
           #I_we_l#, #I_We_u#, #Im_Were_u#, #Ive_Weve_u#, #my_our_l#, #me_us_l#
                       — pronoun tokens, plural when the asker's squad has 2+ members.
    -->

    <!-- Location-free: always safe, must stay the majority of the pool. -->
    <string id="st_wom_chatter_pda_ask_001"><text>Есть кто на связи? Что там снаружи творится?</text></string>
    <string id="st_wom_chatter_pda_ask_002"><text>У нас тихо. У кого-нибудь есть что рассказать?</text></string>
    <string id="st_wom_chatter_pda_ask_003"><text>Ответьте кто-нибудь. Какие новости снаружи?</text></string>
    <string id="st_wom_chatter_pda_ask_004"><text>Проверка связи. Есть ещё кто живой в поле?</text></string>
    <string id="st_wom_chatter_pda_ask_005"><text>Сидим тут без дела. Чем остальные заняты?</text></string>
    <string id="st_wom_chatter_pda_ask_006"><text>Происходит что-нибудь? Весь день ни звука.</text></string>
    <string id="st_wom_chatter_pda_ask_007"><text>Кто там в поле — что у вас перед глазами?</text></string>
    <string id="st_wom_chatter_pda_ask_008"><text>Дайте хоть что-то послушать. Что там снаружи?</text></string>
    <string id="st_wom_chatter_pda_ask_009"><text>Может кто-нибудь снаружи расскажет, чем занят?</text></string>
    <string id="st_wom_chatter_pda_ask_010"><text>Долгая ночь. Скажите, что снаружи ещё что-то происходит.</text></string>

    <!-- Location-bearing: filtered out when the asker's position cannot be resolved. -->
    <string id="st_wom_chatter_pda_ask_011"><text>На точке #location# всё замерло. Как там снаружи?</text></string>
    <string id="st_wom_chatter_pda_ask_012"><text>Засели на точке #location#. Есть у кого что-нибудь?</text></string>
    <string id="st_wom_chatter_pda_ask_013"><text>На точке #location# тихо. У кого-то должно быть что-то поинтереснее.</text></string>
    <string id="st_wom_chatter_pda_ask_014"><text>Весь день на точке #location#. Что там снаружи творится?</text></string>


    <!-- Answerer's opening acknowledgement, prepended as the first sentence of the reply
         (squad-status line, then current-action line). Purely a radio hail: it carries no
         news, so it must never reference a location, a faction or an event. Everything
         concrete belongs to the two sentences that follow.

         Key format: st_wom_chatter_pda_reply_open_{NNN}
         Only the pronoun slots are available; a variant using anything else renders a
         literal token, since _compose_reply builds no other slot for this pool. -->
    <string id="st_wom_chatter_pda_reply_open_001"><text>Приём.</text></string>
    <string id="st_wom_chatter_pda_reply_open_002"><text>Ну здорово.</text></string>
    <string id="st_wom_chatter_pda_reply_open_003"><text>Принято.</text></string>
    <string id="st_wom_chatter_pda_reply_open_004"><text>Слышу чётко.</text></string>
    <string id="st_wom_chatter_pda_reply_open_005"><text>#Im_Were_u# на связи.</text></string>
    <string id="st_wom_chatter_pda_reply_open_006"><text>Да, #I_we_l# слышу тебя.</text></string>
    <string id="st_wom_chatter_pda_reply_open_007"><text>Пока живы, если что.</text></string>
    <string id="st_wom_chatter_pda_reply_open_008"><text>Понял тебя.</text></string>
    <string id="st_wom_chatter_pda_reply_open_009"><text>Ладно, слушай сюда.</text></string>
    <string id="st_wom_chatter_pda_reply_open_010"><text>#Im_Were_u# в эфире.</text></string>
</string_table>
