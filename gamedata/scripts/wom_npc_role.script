
--- wom_npc_role.script
--- NPC role and scheme detection: which smart terrain an NPC is slotted into,
--- what logic scheme they are running, and whether they are standing a watch post.
---
--- Depends on: xsmart (soft), xsquad (soft), xlevel (soft), db.storage

-- Maps an active logic scheme -> a coarse behaviour role. The "working / holding
-- a position" schemes count as "posted"; sitting/sleeping are "settled"/"sleeping";
-- anything else (combat, danger, meet, companion, ...) is nil. Single shared
-- definition (referenced module-qualified, so it is never an empty copy).
SCHEME_ROLE = {
    walker     = "posted",       -- walking a route within a job
    patrol     = "posted",       -- patrolling
    camper     = "posted",       -- holding a position / guard
    smartcover = "posted",       -- occupying a cover post
    sleeper        = "sleeping",  -- sleeping
    animpoint      = "settled",   -- sitting at an animation point
    campfire_point = "settled",   -- gathered at a campfire
}

-- [UNUSED] Guard/sniper/camper job_type_id values — only used by is_posted (below).
-- Kept for future use alongside the posted-NPC dialog topic.
-- local POSTED_JOBS = { [9] = true, [11] = true, [12] = true }

-- [UNUSED] Returns the job_type_id the NPC is slotted into at the given smart terrain, or nil.
-- Only called by is_posted (below). Kept for future use.
-- @param npc   userdata  NPC client game object
-- @param smart userdata  smart terrain server object
-- @return number|nil
-- local function job_type_id(npc, smart)
--     local info = smart and smart.npc_info and smart.npc_info[npc:id()]
--     local job = info and info.job
--     return job and job.job_type_id
-- end

-- Returns the smart terrain server object currently running this NPC's gulag logic,
-- or nil when the NPC is travelling and not yet slotted into any smart.
-- Engine-authoritative: an NPC slotted into a smart job appears in that smart's
-- npc_info roster.
-- @param npc userdata  NPC client game object
-- @return userdata|nil  smart terrain server object
function current_smart(npc)
    if not npc then return nil end
    local npc_id = npc:id()
    if xsmart and xsmart.smart_iter then
        for smart in xsmart.smart_iter() do
            if smart.npc_info and smart.npc_info[npc_id] then return smart end
        end
    end
    return nil
end

-- Returns the NPC's coarse behaviour role derived from their active logic scheme,
-- plus the raw scheme name. "beh" is Anomaly's catch-all gulag scheme; it counts as
-- "posted" except when the NPC is in the idle beh_wait state without the guard
-- animation (i.e. just loitering). Both return values may be nil.
-- @param npc userdata  NPC client game object
-- @return string|nil  role: "posted", "sleeping", "settled", or nil
-- @return string|nil  scheme: active scheme name, e.g. "walker", "beh", or nil
function scheme_role(npc)
    local storage = npc and db.storage[npc:id()]
    local scheme = storage and storage.active_scheme
    local role = (scheme and SCHEME_ROLE[scheme]) or nil
    if scheme == "beh" then
        local beh = storage.beh
        if beh and beh.behavior == "beh_wait" and beh.wait_animation ~= "guard" then
            role = nil
        else
            role = "posted"
        end
    end
    return role, scheme
end

