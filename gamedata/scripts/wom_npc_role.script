-- Returns the id of the smart terrain the squad is currently assigned to, or nil.
-- Squad-level complement of current_smart(): takes a squad server object rather than
-- an NPC client object. Useful when only the squad is available (e.g. death callbacks).
-- @param squad userdata|nil  squad server object
-- @return number|nil
function smart_id_of_squad(squad)
    if not (squad and xsquad and xsquad.get_squad_smart) then return nil end
    local smart = xsquad.get_squad_smart(squad)
    return smart and smart.id or nil
end

-- Returns the id of the nearest smart terrain within `radius` metres of a world
-- position, or nil when SIMBOARD is unavailable or nothing is close enough.
-- Used for lone online mutants that belong to no squad and have no gulag assignment.
--
-- The search is confined to a single level. Positions are per-level coordinate
-- frames, so an unfiltered nearest-smart scan can match a smart on another map
-- whose local coordinates happen to fall inside the radius. `level_id` defaults
-- to the actor's level, which is correct for every current caller (all of them
-- pass a position read from an online object, and online objects are on the
-- actor's level by definition).
-- @param pos      vector      world-space position; resolve it with
--                             wom_utils.get_object_position, never by reading
--                             obj.position (a client object hands back the method)
-- @param radius   number|nil  search radius in metres; defaults to 300
-- @param level_id number|nil  level to confine the search to; defaults to the actor's
-- @return number|nil
function nearest_smart_id(pos, radius, level_id)
    if not pos then return nil end
    -- A non-vector that is nonetheless truthy (the classic case: a client object's
    -- `position` member function, passed in unresolved) reaches xsmart.find_smart
    -- and crashes there on pos.x. Refuse it here instead — losing the smart terrain
    -- on one kill is a far better outcome than a CTD inside a death callback.
    if type(pos) ~= "userdata" and type(pos) ~= "table" then return nil end
    if not (xsmart and xsmart.find_smart) then return nil end
    if not level_id and xlevel and xlevel.get_actor_level_id then
        level_id = xlevel.get_actor_level_id()
    end
    local smart = xsmart.find_smart(pos, {
        max_distance = radius or 300,
        level_id     = level_id,
    })
    return smart and smart.id or nil
end