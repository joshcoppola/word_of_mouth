--- wom_chatter_pda.script
--- Faction-wire idle chatter: a stalker holed up somewhere in the Zone asks the wire
--- what is happening out there, and a few seconds later a squad ALifePlus is actively
--- driving answers with what it is doing.
---
--- Unlike wom_chatter (proximity, online, in earshot) both speakers here may be on any
--- map. Nothing is heard in 3D and no hello bark is played: this is radio traffic the
--- player reads off the PDA, delivered through wom_bark.send_news_pda.
---
--- Scan shape, per exchange attempt (MCM interval, 15-180 real seconds):
---   Asker    — one walk of SIMBOARD.squads. The only per-squad luabind call is
---              sim:object(); the faction test is a lookup into the precomputed
---              wom_bark.allowed_factions set and the "is it sitting still" test is
---              squad.current_action, a plain Lua field on sim_squad_scripted. Both are
---              free, so the walk stays at one crossing per squad. Candidates are
---              reservoir-sampled (no candidate array is built) and the expensive gates
---              -- commander resolution, name lookup, cooldown -- are applied only to
---              the sampled few. Filtering during the walk instead would multiply the
---              crossing count by four or five.
---   Answerer — ap_api.get_scripted_squads() only, which is tens of entries rather than
---              hundreds and is by definition the AP-controlled set. Fetched once per
---              attempt: it deep-copies every entry per call, so it must never be called
---              inside a loop. Two reservoirs are filled in that single pass, one for
---              squads in transit and one for squads sitting at their target, and the
---              moving ones are returned first (a squad out on the road has something
---              more interesting to report than one parked at a camp).
---
--- Both speakers are picked before the question is sent, so the player never sees a
--- question that nothing answers.
---
--- Squad IDs, not squad objects, are carried across the reply delay: squads are released
--- constantly and a captured server object can be dead by the time the reply fires.
---
--- The asker is required to be stationed (squad.current_action == 1, i.e. under smart
--- terrain control), NOT AP-scripted, and on a level other than the player's. Someone
--- parked at a camp or on guard duty is who idly asks the wire for news, not a squad
--- mid-errand; and a voice on the radio should not be standing behind you (proximity
--- chatter is wom_chatter's job, and it does it properly with a 3D bark).
---
--- Off-map is also what makes the asker's location name itself: get_location_name
--- appends the region only when the smart is off the player's level, so an asker that is
--- off-map by construction always renders "the bus stop in Cordon" rather than a bare
--- "the bus stop", with no extra parameter threaded through the terminology helper.
---
--- The ANSWERER is deliberately not level-filtered -- it may be on any map including the
--- player's. Its #location# is where it is HEADING, not where it stands, so an off-map
--- squad bound for the player's own level renders that destination bare ("the bus stop"),
--- which reads correctly to a player standing in that level. See notes/TODO.md for the
--- one case this leaves unqualified.
---
--- Squads are not filtered on combat state. is_in_combat needs a client object
--- (npc:best_enemy()) and an offline squad simply has no observable combat state, so any
--- offline squad may participate.
---
--- A squad whose assigned goal is marked secret in MCM (visibility anything other than
--- "public") is never the answerer. Face-to-face, a secret goal deflects to the generic
--- secretive line and "faction" visibility still answers honestly to one's own; neither
--- applies on a broadcast the player always overhears regardless of who they are taken
--- for. The gate runs at selection AND again at delivery, since the reply renders the
--- goal assigned at reply time and AP can reassign a squad inside the delay.
---
--- Depends on: wom_bark, wom_mcm, wom_recap_npc, wom_dialogue_helper,
---             wom_terminology_helper, wom_debug, ap_api (soft), xsquad (soft),
---             xobject (soft), xtime (soft), db

local TIMER_ID      = "wom_chatter_pda"
local TIMER_EV_TICK = "tick"

-- ONE time event, registered once at on_game_start and never joined by a second.
--
-- The reply used to be its own CreateTimeEvent scheduled from inside the tick's own
-- callback -- which meant assigning a new key to ev_queue[TIMER_ID] while
-- ProcessEventQueue was traversing that exact table with pairs() (_g.script:370-380).
-- The Lua 5.1 manual is explicit that this is undefined: "The behavior of next is
-- undefined if, during the traversal, you assign any value to a non-existent field in
-- the table. You may however modify existing fields." That is precisely why vanilla's
-- own `= nil` on a true return is legal and the insert was not, and the damage is not
-- confined to this feature -- a raise inside ProcessEventQueue aborts every other mod's
-- timers for that frame too.
--
-- So the tick runs on a fixed short interval and all scheduling is plain Lua arithmetic
-- against time_global(). This also deletes the pending-reply wedge risk outright: there
-- is no external event left to lose, so no watchdog is needed to notice it went missing.
local TICK_INTERVAL    = 2     -- real seconds; cheap, almost every tick returns immediately
local FIRST_TICK_DELAY = 30    -- real seconds before the first exchange after load

-- In-game seconds a wire speaker must wait before speaking again.
--
-- Deliberately far shorter than the 1800 the proximity features use. That number exists
-- to stop one NPC in earshot carrying campfire AND chatter AND reaction within one
-- window; at typical time factors it is three to five REAL minutes. Applied to the wire
-- it silenced the feature outright: with one AP-driven squad in scope, that squad answers
-- once and then every tick for the next several minutes re-picks it and aborts. The wire's
-- speakers are remote and offline, so the only real requirement is not hearing the same
-- voice twice in a row.
--
-- Note the asymmetry is deliberate and safe: mark_spoke still writes to the SHARED table,
-- so a wire speaker that later comes online is respected by campfire/chatter at their own
-- longer threshold. Only the read side is relaxed, which is exactly what can_speak's
-- per-call cooldown_sec parameter is for.
local WIRE_COOLDOWN_GAME_SEC = 600

-- How many candidates each reservoir keeps. The post-draw gates (commander resolvable,
-- off cooldown) reject some, and sampling a few is far cheaper than applying those gates
-- to every squad during the walk.
--
-- The answerer needs this as much as the asker. It shipped sampling exactly one, so a
-- single cooled-down candidate aborted the whole exchange with no fallback -- which is
-- what "skipped: answerer commander still on cooldown" turned out to mean in practice.
local ASKER_CANDIDATES    = 3
local ANSWERER_CANDIDATES = 3

-- { claim = { id, faction }, due_at = time_global() ms } while a reply is owed, else nil.
-- Purely module state now, so a level change cannot strand it.
local _pending_reply = nil

-- time_global() ms at which the next exchange may start; nil until the first pump.
local _next_exchange_at = nil

-- ---- helpers ----------------------------------------------------------------

-- Trace channel; one distinct line per rejection reason. "Nothing fired" has many
-- innocent causes here (feature off, no actor, AP absent, no stationed squad in scope,
-- no scripted squad in scope, reply still pending, empty render) and they are
-- indistinguishable from the player's chair, so each gets its own message.
-- @param message string
local function _trace(message)
    if wom_debug and wom_debug.log_trace then
        wom_debug.log_trace("wom_chatter_pda", message)
    end
end

-- Returns the player's true (disguise-piercing) community, or nil.
-- @return string|nil
local function _player_community()
    if get_actor_true_community then return get_actor_true_community() end
    return db.actor and db.actor:character_community() or nil
end

-- Current in-game time in seconds, or 0 when xtime is absent.
-- @return number
local function _now_sec()
    return (xtime and xtime.game_sec and xtime.game_sec()) or 0
end

-- Resolves the (name, icon) pair for a squad's commander, falling back to the generic
-- faction display when the commander cannot be resolved.
--
-- The lookup is wrapped in pcall because xsquad.get_commander_name reads
-- db.storage[cmd_id].object and calls IsStalker/character_name on it directly
-- (xsquad.script:205-209). That table can outlive the object the engine destroyed —
-- db's cleanup lags a frame behind an NPC going offline or dying — and any method call
-- on a destroyed object raises "you are trying to use a destroyed object". This is the
-- single most likely raise in the whole feature, because the reply fires seconds after
-- the question and a commander can die in that window; without the pcall it propagates
-- to the timer's own pcall and the exchange vanishes into one log line. Degrading to the
-- faction handle keeps the message.
-- @param squad userdata  squad server object
-- @return string|nil name, string icon  nil name when nothing could be resolved at all
local function _commander_display(squad)
    local ok, name
    if xsquad and xsquad.get_commander_name then
        ok, name = pcall(xsquad.get_commander_name, squad)
        if not ok then name = nil end
    end
    if name and name ~= "" then
        local commander_id = squad.commander_id and squad:commander_id()
        local commander    = commander_id and xobject and xobject.se and xobject.se(commander_id)
        local icon_ok, icon = pcall(function()
            return (commander and commander:character_icon()) or ""
        end)
        return name, (icon_ok and icon) or ""
    end
    local faction = squad.player_id
    if not faction then return nil, "" end
    return wom_bark.faction_display(faction)
end

-- Smart terrain the squad is sitting at, for the asker's #location# slot.
-- @param squad userdata  squad server object
-- @return number|nil
local function _stationed_smart_id(squad)
    return squad.smart_id or squad.current_target_id or squad.assigned_target_id
end

-- True when the squad is provably on a different level from the player.
--
-- xlevel.get_level_id costs 0 luabind on a warm cache (xlevel.script:38-49): the
-- vertex-to-level mapping is baked into game.graph and immutable, so it is cached per
-- game vertex id, and squads parked at smart terrains reuse the same handful of vertices
-- tick after tick. A cold gvid costs 3 trivial calls, once ever.
--
-- Returns false when either level is unresolvable. "Cannot prove it is off-map" must read
-- as "not eligible", never as "probably fine" -- see _sample_asker_ids.
-- @param squad          userdata     squad server object
-- @param actor_level_id number       the player's level id
-- @return boolean
local function _is_off_map(squad, actor_level_id)
    if not actor_level_id then return false end
    if not (xlevel and xlevel.get_level_id) then return false end
    local level_id = xlevel.get_level_id(squad)
    return level_id ~= nil and level_id ~= actor_level_id
end

-- ---- asker selection --------------------------------------------------------

-- Single walk of the squad registry, reservoir-sampling stationed off-map squads of an
-- in-scope faction that ALifePlus is not currently driving. Returns squad IDs, not objects.
--
-- Iterates via xsquad.iter_squads rather than SIMBOARD.squads directly: it carries the
-- SIMBOARD/alife nil guards and skips squads alife has already deleted, and it resolves
-- the server object itself, which is the one luabind call this walk was always going to
-- pay. Note squad.id is a FIELD on the yielded server object, not a method.
--
-- The level test is deliberately LAST in the chain. The three before it are pure Lua
-- table and field reads, so they reject the bulk of the registry for nothing;
-- xlevel.get_level_id is 0 luabind on a warm cache but still a field read plus a table
-- lookup, and 3 trivial luabind on a cold gvid. Letting the free tests filter first keeps
-- it off almost every squad.
--
-- An unresolvable level (squad mid-transition) is EXCLUDED, not included: the invariant
-- this filter exists to hold is "the asker is always off-map", and a squad whose level
-- cannot be proven different is not proof of anything.
--
-- The story-character test belongs in this walk specifically, ahead of the level test:
-- "stationed, unscripted, off-map" is an exact description of a trader squad parked at its
-- smart terrain (bar_visitors_barman_stalker_trader_squad and friends are
-- online_offline_group squads under smart control), so without it Sidorovich and the barman
-- are prime asker candidates. squad.id is a free field read, so it stays among the free
-- tests; the commander-level half of the gate waits until _first_eligible_asker, where a
-- commander is resolved anyway.
--
-- Algorithm R over the accept set: candidates beyond the reservoir size replace a random
-- slot with probability k/n, which keeps the sample uniform without building an array of
-- every match. See the header for why the per-squad tests are all free.
-- @param allowed        table   set of in-scope community strings
-- @param scripted       table   ap_api.get_scripted_squads() result, fetched once by the caller
-- @param actor_level_id number  the player's level; squads on it are excluded
-- @return table  array of squad IDs, at most ASKER_CANDIDATES entries
local function _sample_asker_ids(allowed, scripted, actor_level_id)
    local reservoir, seen = {}, 0
    if not (xsquad and xsquad.iter_squads) then return reservoir end

    for squad in xsquad.iter_squads() do
        if allowed[squad.player_id]
           and squad.current_action == 1
           and not scripted[squad.id]
           and not wom_bark.is_story_character(squad.id)
           and _is_off_map(squad, actor_level_id) then
            seen = seen + 1
            if seen <= ASKER_CANDIDATES then
                reservoir[#reservoir + 1] = squad.id
            else
                local slot = math.random(seen)
                if slot <= ASKER_CANDIDATES then reservoir[slot] = squad.id end
            end
        end
    end
    return reservoir
end

-- Applies the expensive gates to sampled asker candidates in order and returns the first
-- that passes: squad still alive, has members, commander not a story character, commander
-- name resolvable, off cooldown.
--
-- The story test runs at both levels because the two can disagree: a smart terrain
-- respawning a unique trader (smart_terrain_warfare.check_unique_npcs) puts a story NPC in
-- command of an unremarkable squad, and attrition can leave a story squad commanded by a
-- generated stalker. Ordered before can_speak so an excluded candidate does not consume a
-- cooldown lookup, and left inside the loop so exclusion falls through to the next sampled
-- candidate rather than aborting the exchange.
-- @param candidate_ids table   array of squad IDs
-- @param now_sec       number  current in-game seconds
-- @return userdata|nil squad, string|nil name, string icon
local function _first_eligible_asker(candidate_ids, now_sec)
    local sim = alife()
    if not sim then return nil end
    for i = 1, #candidate_ids do
        local squad = sim:object(candidate_ids[i])
        if squad and (squad.npc_count and squad:npc_count() or 0) > 0 then
            local commander_id = squad.commander_id and squad:commander_id()
            if commander_id
               and not wom_bark.is_story_character(commander_id)
               and wom_bark.can_speak(commander_id, now_sec, WIRE_COOLDOWN_GAME_SEC) then
                local name, icon = _commander_display(squad)
                if name then return squad, name, icon end
            end
        end
    end
    return nil
end

-- ---- answerer selection -----------------------------------------------------

-- Single pass over the AP-scripted squad set, filling two reservoirs: squads in transit
-- and squads sitting at their target. Returns the moving candidates first, then the parked
-- ones, so the caller takes the first that passes its gates and a moving squad wins
-- whenever any moving squad is usable -- a squad out on the road has something more
-- interesting to report than one parked at a camp.
--
-- Returning a LIST rather than one id is what makes the cooldown gate survivable. Sampling
-- one candidate and aborting when it was cooled down is what took the feature off the air.
-- @param allowed    table   set of in-scope community strings
-- @param scripted   table   ap_api.get_scripted_squads() result
-- @param exclude_id number  the asker's squad ID
-- @return table  array of squad IDs, moving first, at most 2*ANSWERER_CANDIDATES entries
local function _sample_answerer_ids(allowed, scripted, exclude_id)
    local sim = alife()
    if not sim then return {} end

    local moving,  moving_seen  = {}, 0
    local arrived, arrived_seen = {}, 0

    -- Algorithm R, one reservoir per bucket. See _sample_asker_ids.
    local function offer(reservoir, seen, squad_id)
        seen = seen + 1
        if seen <= ANSWERER_CANDIDATES then
            reservoir[#reservoir + 1] = squad_id
        else
            local slot = math.random(seen)
            if slot <= ANSWERER_CANDIDATES then reservoir[slot] = squad_id end
        end
        return seen
    end

    for squad_id in pairs(scripted) do
        if squad_id ~= exclude_id then
            local squad = sim:object(squad_id)
            if squad
               and allowed[squad.player_id]
               and (squad.npc_count and squad:npc_count() or 0) > 0 then
                if squad.current_action == 1 then
                    arrived_seen = offer(arrived, arrived_seen, squad_id)
                else
                    moving_seen = offer(moving, moving_seen, squad_id)
                end
            end
        end
    end

    for i = 1, #arrived do moving[#moving + 1] = arrived[i] end
    return moving
end

-- True when the squad's currently assigned goal is marked secret in MCM -- i.e. its
-- visibility is anything other than "public".
--
-- The wire is a broadcast: whatever an answerer says lands on the player's PDA no matter
-- whose faction they are or claim to be, so there is no equivalent of the face-to-face
-- outsider test to make. A goal the player is not universally meant to hear about
-- therefore disqualifies the squad from answering at all, rather than being deflected to
-- the generic secretive line -- a wire exchange where the answer is "can't say" is worse
-- than picking a squad with something to report.
--
-- Cost is one ap_api.get_record on the { squad_id, assigned = true } fast path, which
-- reads the live index in O(1). That is why this is a post-draw gate applied to the
-- sampled few and not a filter inside the scripted-squad walk.
-- @param squad_id number  squad server object ID
-- @return boolean
local function _goal_is_secret(squad_id)
    if not (ap_api and ap_api.get_record) then return false end
    local record = ap_api.get_record({ squad_id = squad_id, assigned = true })
    local goal   = record and record.consequence_key
                          and record.consequence_key:match("^consequence:(.+)")
    if not goal then return false end
    return wom_mcm.get_goal_visibility(goal) ~= "public"
end

-- Applies the post-draw gates to answerer candidates in order and returns the first that
-- passes. Mirrors _first_eligible_asker; kept separate because the answerer needs no
-- name resolution here (the reply re-resolves it after the delay anyway).
-- @param candidate_ids table   array of squad IDs, in preference order
-- @param now_sec       number  current in-game seconds
-- @return userdata|nil squad, number|nil squad_id
local function _first_eligible_answerer(candidate_ids, now_sec)
    local sim = alife()
    if not sim then return nil end
    for i = 1, #candidate_ids do
        local squad_id = candidate_ids[i]
        local squad    = sim:object(squad_id)
        if squad then
            local commander_id = squad.commander_id and squad:commander_id()
            if commander_id
               and not wom_bark.can_speak(commander_id, now_sec, WIRE_COOLDOWN_GAME_SEC) then
                -- on cooldown; try the next candidate
            elseif wom_bark.is_story_character(squad_id)
                   or wom_bark.is_story_character(commander_id) then
                _trace("answerer candidate " .. tostring(squad_id) .. " skipped: story character")
            elseif _goal_is_secret(squad_id) then
                _trace("answerer candidate " .. tostring(squad_id) .. " skipped: goal is secret")
            else
                return squad, squad_id
            end
        end
    end
    return nil
end

-- ---- message composition ----------------------------------------------------

-- Builds the asker's question line.
-- #location# is gated: a squad whose smart cannot be resolved falls back to the
-- location-free half of the pool rather than rendering an empty slot.
-- @param squad userdata  asker squad server object
-- @return string  rendered question, or "" when no variant survived
local function _compose_question(squad)
    local plural = (squad.npc_count and squad:npc_count() or 0) > 1
    local slots  = wom_dialogue_helper.make_pronoun_slots(plural)
    local smart_id = _stationed_smart_id(squad)
    slots.location = smart_id
                     and wom_terminology_helper.get_location_name(smart_id)
                     or ""
    return wom_dialogue_helper.pick_dialogue_variant("st_wom_chatter_pda_ask", slots, { "location" })
end

-- Builds the answerer's reply: an opening acknowledgement, then the squad-composition
-- sentence, then the current-action sentence. The latter two come from wom_recap_npc with
-- no client object, so they render off the server-side squad alone. Either may come back
-- empty; the reply is only sent when the action sentence renders, since that is the part
-- carrying the news.
--
-- The opener is a plain radio hail carrying no news, so it is never a reason to send a
-- message on its own: it is rendered only after the action sentence has been established
-- and an empty render simply drops it. It also gets no gated_tokens -- its pool uses only
-- the pronoun slots, which are always populated.
-- @param squad userdata  answerer squad server object
-- @return string  rendered reply, or "" when the action sentence is empty
local function _compose_reply(squad)
    -- force_region: the answerer is deliberately not level-filtered, so its destination may
    -- be on the player's own map, where get_location_name would otherwise render it bare
    -- ("the bus stop"). That is fine for a stalker standing in front of you and wrong for a
    -- voice on the radio, who could be anywhere -- so the wire always names the region.
    local action = wom_recap_npc.render_current_action(squad, nil, nil, nil, true)
    if action == "" then return "" end

    local plural = (squad.npc_count and squad:npc_count() or 0) > 1
    local opener = wom_dialogue_helper.pick_dialogue_variant(
        "st_wom_chatter_pda_reply_open", wom_dialogue_helper.make_pronoun_slots(plural))

    local status = wom_recap_npc.render_squad_status(squad)
    local body   = (status == "") and action or (status .. " " .. action)
    if opener == "" then return body end
    return opener .. " " .. body
end

-- ---- delivery ---------------------------------------------------------------

-- Re-resolves the answerer squad and delivers its reply, seconds after the question went
-- out. Everything about the squad may have changed in that window, so nothing captured at
-- question time is trusted except the identity claim itself.
--
-- The four states that have to be told apart:
--   released    — sim:object returns nil. Nothing to say.
--   ID reused   — alife recycles object IDs, so the ID can now belong to a DIFFERENT
--                 squad, potentially another faction or a mutant pack. The captured
--                 faction is re-checked; a mismatch means this is not who was asked.
--   wiped       — the squad object outlives its last member briefly. npc_count() == 0
--                 would render through the "alone" pool and have a dead squad announce
--                 that it is on its own out there.
--   online/offline flip — harmless by construction. The reply renders through the offline
--                 path either way, which never touches db.storage[...].object and so
--                 cannot trip the destroyed-object raise; a squad that came online since
--                 the question simply renders without absent-member detail.
-- @param claim table  { id, faction } captured when the question was sent
local function _deliver_reply(claim)
    if not db.actor then
        _trace("reply skipped: no actor to receive it")
        return
    end

    local sim   = alife()
    local squad = sim and sim:object(claim.id)
    if not squad then
        _trace("reply skipped: answerer squad " .. tostring(claim.id) .. " no longer exists")
        return
    end
    if squad.player_id ~= claim.faction then
        _trace("reply skipped: squad ID " .. tostring(claim.id) .. " was reused (expected "
               .. tostring(claim.faction) .. ", found " .. tostring(squad.player_id) .. ")")
        return
    end
    if (squad.npc_count and squad:npc_count() or 0) == 0 then
        _trace("reply skipped: answerer squad " .. tostring(claim.id) .. " was wiped out")
        return
    end
    -- Re-checked, not trusted from selection time: the reply renders whatever goal is
    -- assigned NOW, and ALifePlus can reassign a squad inside the delay. Gating only at
    -- selection would let a squad that picked up a secret goal in that window announce it.
    if _goal_is_secret(claim.id) then
        _trace("reply skipped: answerer squad " .. tostring(claim.id)
               .. " picked up a secret goal since the question")
        return
    end

    local message = _compose_reply(squad)
    if message == "" then
        _trace("reply skipped: nothing rendered for squad " .. tostring(claim.id))
        return
    end

    local name, icon = _commander_display(squad)
    if not name then
        _trace("reply skipped: no sender resolvable for squad " .. tostring(claim.id))
        return
    end

    wom_bark.send_news_pda(name, icon, message, "wom_chatter_pda")

    -- Marked against whoever leads the squad NOW, not who led it when asked: if the
    -- original commander died, the replacement is the one who just spoke.
    local commander_id = squad.commander_id and squad:commander_id()
    if commander_id then wom_bark.mark_spoke(commander_id, _now_sec()) end
end

-- Records that a reply is owed. No time event: the tick pump delivers it once due.
-- @param claim table   { id, faction } identifying the answerer
-- @param delay number  real seconds
local function _schedule_reply(claim, delay)
    _pending_reply = { claim = claim, due_at = time_global() + (delay * 1000) }
end

-- ---- scan -------------------------------------------------------------------

-- One exchange attempt. Picks both speakers before sending anything, so a question is
-- never left hanging.
local function _run_exchange()
    if not db.actor then return end

    -- The wire only speaks into a quiet PDA. The window is closed by ANY WoM message,
    -- not just the wire's own, so idle radio traffic keeps out of the way of the features
    -- reporting things that are actually happening near the player. This is the only
    -- feature gated this way -- campfire, chatter, reaction and outposts stamp the window
    -- but never test it, because each already has pacing suited to what it reports.
    --
    -- Tested only at the START of an exchange. _deliver_reply is deliberately NOT gated:
    -- by then the question is already on the player's PDA (and is itself what most
    -- recently stamped the window), and a question the player watches go unanswered is
    -- worse than silence. Placed before every scan, so a busy PDA skips the registry walk.
    if not wom_bark.is_pda_quiet(wom_mcm.chatter_pda_quiet_gap()) then
        _trace("skipped: PDA quiet window not elapsed")
        return
    end

    if not (ap_api and ap_api.get_scripted_squads and ap_api.get_record) then
        _trace("skipped: ALifePlus not available")
        return
    end

    local player_comm = _player_community()
    if not player_comm then
        _trace("skipped: player community unresolved")
        return
    end

    -- Resolved once per tick and required: with no actor level nothing can be proven
    -- off-map, and the asker invariant is not worth guessing at. Skipping the tick also
    -- keeps wire chatter out of a level transition, where the player has other concerns.
    local actor_level_id = xlevel and xlevel.get_actor_level_id and xlevel.get_actor_level_id()
    if not actor_level_id then
        _trace("skipped: actor level unresolved (loading or mid-transition)")
        return
    end

    local allowed  = wom_bark.allowed_factions(player_comm, wom_mcm.chatter_pda_scope())
    local scripted = ap_api.get_scripted_squads() or {}
    local now_sec  = _now_sec()

    local candidate_ids = _sample_asker_ids(allowed, scripted, actor_level_id)
    if #candidate_ids == 0 then
        _trace("skipped: no stationed unscripted off-map squad in scope")
        return
    end

    local asker_squad, asker_name, asker_icon = _first_eligible_asker(candidate_ids, now_sec)
    if not asker_squad then
        _trace("skipped: all " .. #candidate_ids .. " asker candidates gated (cooldown or unresolvable)")
        return
    end

    local answerer_ids = _sample_answerer_ids(allowed, scripted, asker_squad.id)
    if #answerer_ids == 0 then
        _trace("skipped: no AP-scripted squad in scope to answer")
        return
    end

    local answerer_squad, answerer_id = _first_eligible_answerer(answerer_ids, now_sec)
    if not answerer_squad then
        _trace("skipped: all " .. #answerer_ids .. " answerer candidates gated (cooldown or secret goal)")
        return
    end

    local question = _compose_question(asker_squad)
    if question == "" then
        _trace("skipped: question pool rendered empty")
        return
    end

    wom_bark.send_news_pda(asker_name, asker_icon, question, "wom_chatter_pda")

    local asker_commander_id = asker_squad.commander_id and asker_squad:commander_id()
    if asker_commander_id then wom_bark.mark_spoke(asker_commander_id, now_sec) end

    -- Carry the faction alongside the ID so the reply can detect an ID recycled onto a
    -- different squad during the delay. Never carry the squad object itself.
    _schedule_reply({ id = answerer_id, faction = answerer_squad.player_id },
                    wom_mcm.chatter_pda_reply_delay())
end

-- Drives both phases off the single tick. A due reply always wins over starting a new
-- exchange, and no new exchange begins while one is owed, so question and answer stay
-- paired without needing a second time event to arbitrate them.
--
-- _pending_reply is cleared BEFORE delivery, not after: if _deliver_reply raises, the
-- pcall in _on_timer catches it and the next pump starts a fresh exchange rather than
-- retrying a delivery that already failed once.
local function _pump()
    if not wom_mcm.chatter_pda_enabled() then
        -- An owed reply is dropped rather than parked. The enabled check used to sit ahead
        -- of the pending-reply branch and simply return, so toggling the feature off inside
        -- the reply delay left _pending_reply set with an expired due_at: re-enabling minutes
        -- or hours later fired it on the very next tick, detached from the question it
        -- answers. A lost reply is the same outcome as the answerer having been released,
        -- which _deliver_reply already treats as normal.
        _pending_reply = nil
        return
    end
    local now_ms = time_global()

    if _pending_reply then
        if now_ms < _pending_reply.due_at then return end
        local claim = _pending_reply.claim
        _pending_reply = nil
        _deliver_reply(claim)
        return
    end

    if not _next_exchange_at then
        _next_exchange_at = now_ms + (FIRST_TICK_DELAY * 1000)
        return
    end
    if now_ms < _next_exchange_at then return end

    -- Re-armed before the attempt, not after, so an exchange that bails on a gate still
    -- waits a full interval instead of retrying every two seconds and flooding the trace.
    _next_exchange_at = now_ms + (wom_mcm.chatter_pda_interval() * 1000)
    _run_exchange()
end

-- Timer callback. Runs the pump under pcall so one bad squad cannot kill the timer.
-- @return boolean  false, to keep the event registered
local function _on_timer()
    ResetTimeEvent(TIMER_ID, TIMER_EV_TICK, TICK_INTERVAL)
    local ok, err = pcall(_pump)
    if not ok and printf then printf("~[wom_chatter_pda] pump error: %s", tostring(err)) end
    return false
end

-- ---- public -----------------------------------------------------------------

function on_game_start()
    _pending_reply    = nil
    _next_exchange_at = nil
    wom_bark.reset_cooldowns()
    wom_bark.reset_quiet_window()
    -- The wire is the only reader of the quiet window, so it is also what installs the
    -- hooks that let non-WoM PDA messages close it. Idempotent across loads.
    wom_bark.hook_external_news()
    CreateTimeEvent(TIMER_ID, TIMER_EV_TICK, TICK_INTERVAL, _on_timer)
end
